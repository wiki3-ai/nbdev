// nbdev devcontainer — Jupyter Docker Stacks "pytorch" variant.
//
// Adds PyTorch (CPU build by default) on top of scipy-notebook.
// For GPU support see jupyter/docker-stacks docs and add a runArgs entry
// such as ["--gpus=all", "--user", "root"] plus an NVIDIA-capable host.
{
    "name": "nbdev (pytorch)",
    "build": {
        "context": "../..",
        "dockerfile": "../../Dockerfile",
        "args": {
            "BASE_IMAGE": "quay.io/jupyter/pytorch-notebook:latest",
            "QUARTO_VERSION": "latest"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "quarto.quarto"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/opt/conda/bin/python",
                "quarto.python.pythonPath": "/opt/conda/bin/python"
            }
        }
    },
    "remoteUser": "jovyan",
    "runArgs": ["--user", "root"],
    "overrideCommand": false,
    "containerEnv": {
        "GRANT_SUDO": "no",
        "NOTEBOOK_ARGS": "--ServerApp.token='SECRET' --ServerApp.password='' --ServerApp.disable_check_xsrf=True",
        "RESTARTABLE": "yes",
        "QUARTO_PATH": "/opt/quarto/bin/quarto",
        "QUARTO_PYTHON": "/opt/conda/bin/python"
    },
    "workspaceFolder": "/home/jovyan/work",
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/jovyan/work,type=bind,consistency=cached",
    "forwardPorts": [8888, 3000, 4200],
    "portsAttributes": {
        "8888": {"label": "Jupyter"},
        "3000": {"label": "Quarto preview"},
        "4200": {"label": "nbdev preview"}
    },
    "postCreateCommand": "pip install -e '.[dev]' && nbdev-install-hooks || true"
}
