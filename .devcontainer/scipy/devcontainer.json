// nbdev devcontainer — Jupyter Docker Stacks "scipy" variant.
//
// Adds the scientific Python stack (numpy, pandas, matplotlib, scikit-learn,
// scikit-image, sympy, seaborn, statsmodels, etc.) on top of the minimal image.
// See https://jupyter-docker-stacks.readthedocs.io/en/latest/using/selecting.html
//
// Consumes the published GHCR image (exemplar of the downstream pattern).
{
    "name": "nbdev (scipy)",
    "image": "ghcr.io/wiki3-ai/nbdev-devcontainer:scipy",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "quarto.quarto"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/opt/conda/bin/python",
                "quarto.python.pythonPath": "/opt/conda/bin/python"
            }
        }
    },
    "remoteUser": "jovyan",
    "runArgs": [
        "--user",
        "root"
    ],
    "overrideCommand": false,
    "containerEnv": {
        "GRANT_SUDO": "no",
        "NOTEBOOK_ARGS": "--ServerApp.token='SECRET' --ServerApp.password='' --ServerApp.disable_check_xsrf=True",
        "RESTARTABLE": "yes",
        "QUARTO_PATH": "/opt/quarto/bin/quarto",
        "QUARTO_PYTHON": "/opt/conda/bin/python"
    },
    "workspaceFolder": "/home/jovyan/work",
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/jovyan/work,type=bind,consistency=cached",
    "forwardPorts": [
        8888,
        3000,
        4200
    ],
    "portsAttributes": {
        "8888": {
            "label": "Jupyter"
        },
        "3000": {
            "label": "Quarto preview"
        },
        "4200": {
            "label": "nbdev preview"
        }
    },
    "postCreateCommand": "nbdev-install-hooks || true"
}